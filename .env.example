# انسخ هذا الملف إلى .env للتطوير المحلي فقط.
# لا تضع القيم الحقيقية هنا ولا في المستودع — اضبطها في متغيرات بيئة Railway (أو منصة الاستضافة).

# ----- المنفذ (اختياري، Railway يضبطه تلقائياً) -----
PORT=3000

# ----- مصادقة HTTP Basic (مطلوب أحد الخيارين التاليين على الأقل) -----
# خيار 1: حساب واحد
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# خيار 2: عدة حسابات متساوية الصلاحية (JSON)
# BASIC_AUTH_USERS_JSON={"name-one":"password-one","name-two":"password-two"}

# ----- حدود معدل الطلبات (اختياري) -----
AUTH_RATE_LIMIT_MAX=200
API_RATE_LIMIT_MAX=600

# ----- Supabase (التخزين الدائم — مطلوب في الإنتاج) -----
SUPABASE_URL=
SUPABASE_KEY=

# فرض رفض الحفظ إن لم يتوفر اتصال Supabase (يمنع فقدان صامت للبيانات على تخزين مؤقت)
REQUIRE_DURABLE_SYNC=true

# مسار التخزين المحلي الاحتياطي — اربطه بوحدة تخزين دائمة إن أمكن
# DATA_DIR=/app/data

# ----- تنبيهات تيليجرام عند انقطاع/عودة اتصال Supabase (اختياري) -----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ----- ترحيل بيانات لمرة واحدة (اختياري، راجع migrate-persons-fix.js) -----
# RUN_PERSON_FIX_2026_08=true
